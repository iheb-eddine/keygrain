      }
    },
    {
      "name": "empty_remote_deletes_synced_local_records",
      "lastSuccessfulSyncAt": 500,
      "remoteExists": true,
      "local": [{"id": "a", "site": "s-a.com", "email": "a@b.com", "updated_at": 100, "synced": true}],
