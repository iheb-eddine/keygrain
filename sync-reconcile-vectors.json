      "tombstones": [],
      "remote": [{"id": "r", "site": "repair-remote.com", "email": "a@b.com", "updated_at": 100}],
      "expect": {
        "merged": [{"id": "r", "synced": true, "updated_at": 100, "site": "repair-remote.com"}],
