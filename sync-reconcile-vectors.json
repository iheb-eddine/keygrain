      "remoteExists": true,
      "local": [
        {"id": "d", "site": "gone.com", "email": "a@b.com", "updated_at": 100, "synced": true},
        {"id": "keep", "site": "keep.com", "email": "a@b.com", "updated_at": 100, "synced": true}
      ],
      "tombstones": [],
