        "merged": [],
        "deletedIds": [], "review": [], "tombstones": [], "resurrected": []
      }
    },
    {
      "name": "duplicate_collapse_synced_loser_is_declared_and_tombstoned",
      "lastSuccessfulSyncAt": 0,
      "remoteExists": true,
      "local": [
        {"id": "a", "site": "dup.com", "email": "a@b.com", "updated_at": 200, "synced": true},
        {"id": "b", "site": "dup.com", "email": "a@b.com", "updated_at": 100, "synced": true}
      ],
      "tombstones": [],
      "remote": [
        {"id": "a", "site": "dup.com", "email": "a@b.com", "updated_at": 200},
        {"id": "b", "site": "dup.com", "email": "a@b.com", "updated_at": 100}
      ],
      "expect": {
        "merged": [{"id": "a", "synced": true, "updated_at": 200, "site": "dup.com"}],
        "deletedIds": ["b"], "review": [], "tombstones": ["b"], "resurrected": []
      }
    }
  ]
