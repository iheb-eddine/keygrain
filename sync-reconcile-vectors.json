{
  "_comment": "Sync v3 deletion-reconciliation oracle, consumed by BOTH extension/tests/test.mjs and kotlin SyncReconcileTest.kt. One table, two platforms — closes the 'no cross-platform integration test' drift vector for sync (designs/sync-deletion-reconciliation.md, Test Plan). NOT to be confused with sync-vectors.json (a derivation/decrypt fixture). Each scenario feeds reconcileServices(local, tombstones, remoteContent, remoteMeta, lastSuccessfulSyncAt, remoteExists); the harness splits each 'remote' entry into content (site/email/...) and metadata (updated_at). Winner vectors give local and remote DIFFERENT sites so the compared 'site' fingerprint proves the right record's content won. Services that would be materially different on dedup are avoided so no SyncConflict is constructed (org.json semantics differ in the Kotlin unit runtime). Expectations: merged is sorted by id as [{id,synced,updated_at,site}]; deletedIds/review/tombstones/resurrected are sorted id lists.",
  "vectors": [
    {
      "name": "rule3_local_newer_wins",
      "lastSuccessfulSyncAt": 0,
      "remoteExists": true,
      "local": [{"id": "a", "site": "local3.com", "email": "a@b.com", "updated_at": 200, "synced": true}],
      "tombstones": [],
      "remote": [{"id": "a", "site": "remote3.com", "email": "a@b.com", "updated_at": 100}],
      "expect": {
        "merged": [{"id": "a", "synced": true, "updated_at": 200, "site": "local3.com"}],
        "deletedIds": [], "review": [], "tombstones": [], "resurrected": []
      }
    },
    {
      "name": "rules12_remote_wins_ties",
      "lastSuccessfulSyncAt": 0,
      "remoteExists": true,
      "local": [{"id": "a", "site": "local12.com", "email": "a@b.com", "updated_at": 100, "synced": true}],
      "tombstones": [],
      "remote": [{"id": "a", "site": "remote12.com", "email": "a@b.com", "updated_at": 100}],
      "expect": {
        "merged": [{"id": "a", "synced": true, "updated_at": 100, "site": "remote12.com"}],
        "deletedIds": [], "review": [], "tombstones": [], "resurrected": []
      }
    },
    {
      "name": "rule4_unsynced_local_only_is_pushed_not_deleted",
      "lastSuccessfulSyncAt": 0,
      "remoteExists": true,
      "local": [{"id": "new1", "site": "brand-new.com", "email": "a@b.com", "updated_at": 300, "synced": false}],
      "tombstones": [],
      "remote": [],
      "expect": {
        "merged": [{"id": "new1", "synced": false, "updated_at": 300, "site": "brand-new.com"}],
        "deletedIds": [], "review": [], "tombstones": [], "resurrected": []
      }
    },
    {
      "name": "rule5_remote_only_is_created_locally",
      "lastSuccessfulSyncAt": 0,
      "remoteExists": true,
      "local": [],
