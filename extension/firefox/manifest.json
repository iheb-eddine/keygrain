{
  "manifest_version": 3,
  "name": "Keygrain",
  "version": "1.3.0",
  "description": "Deterministic password generator with encrypted sync. Your master password never leaves your device.",
  "homepage_url": "https://github.com/iheb-eddine/keygrain",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://keygrain.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["lib/public_suffix_list.js", "public-suffix.js", "lib/hash-wasm-argon2.js", "keygrain.js", "unlock-state.js", "popup-crypto.js", "worker-ingress.js", "worker-update-version.js", "lib/tweetnacl.js", "ssh.js", "bip39-wordlist.js", "wallet.js", "browser-owner.js", "diagnostics.js", "totp.js", "sync.js", "autofill.js", "inline-autofill.js", "background.js"]
  },
  "commands": {
    "fill_credentials": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Fill credentials for current site"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@keygrain.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
